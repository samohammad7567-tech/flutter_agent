import 'package:flutter/material.dart';

import '../../data/models/{{feature}}_model.dart';

/// Dumb by contract: it displays what it is handed and reports taps upward.
class {{Feature}}Tile extends StatelessWidget {
  const {{Feature}}Tile({super.key, required this.item, this.onTap});

  final {{Feature}}Model item;
  final ValueChanged<{{Feature}}Model>? onTap;

  @override
  Widget build(BuildContext context) {
    return ListTile(
      onTap: onTap == null ? null : () => onTap!(item),
      title: Text(
        item.title,
        maxLines: 2,
        overflow: TextOverflow.ellipsis,
      ),
