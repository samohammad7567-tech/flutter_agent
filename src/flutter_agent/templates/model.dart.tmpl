/// One {{feature_words}} record as the backend returns it.
class {{Feature}}Model {
  const {{Feature}}Model({required this.id, required this.title, this.createdAt});

  factory {{Feature}}Model.fromJson(Map<String, dynamic> json) {
    return {{Feature}}Model(
      id: json['id']?.toString() ?? '',
      title: json['title']?.toString() ?? '',
      createdAt: _parseDate(json['created_at']),
    );
  }

  final String id;
  final String title;
  final DateTime? createdAt;

  /// `id` and `created_at` are owned by the backend, so they never go out.
  Map<String, dynamic> toJson() => <String, dynamic>{'title': title};

  {{Feature}}Model copyWith({String? id, String? title, DateTime? createdAt}) {
    return {{Feature}}Model(
      id: id ?? this.id,
      title: title ?? this.title,
      createdAt: createdAt ?? this.createdAt,
    );
  }

  /// Accepts both an ISO string and a Firestore `Timestamp`-shaped value.
  static DateTime? _parseDate(Object? raw) {
    if (raw == null) return null;
    if (raw is DateTime) return raw;
    if (raw is int) return DateTime.fromMillisecondsSinceEpoch(raw);
    final Object? seconds = raw is Map ? raw['_seconds'] ?? raw['seconds'] : null;
    if (seconds is int) {
      return DateTime.fromMillisecondsSinceEpoch(seconds * 1000);
    }
    return DateTime.tryParse(raw.toString());
  }
}
